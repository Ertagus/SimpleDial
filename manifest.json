{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.0.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "homepage_url": "https://chromewebstore.google.com/detail/simpledial/mpgblhliidfflfdofhpbhjijmncnamfk",
  "author": { "email": "Ertagus@gmail.com" },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
